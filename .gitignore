# ---- Raw Kaggle download (multi-GB) — never committed ----
# Files sit directly in data/, and the unzipped CSVs in their own folders.
data/raw/
data/*.csv
data/*.csv.gz
data/*.zip
data/**/*.csv
data/**/*.csv.gz

# ...but the small summary tables ARE committed, so a fresh clone can
# rebuild the charts via `python figures/make_figures.py` without the 4GB download:
# master_scale, scenario_table, loss_concentration, walkforward, gains_table,
# scorecard_points, scorecard_coefficients, lifetime_pd, feature_set.json
!data/processed/
!data/processed/*.csv

# ---- Cached intermediate frames — regenerated by notebooks 01 and 02 ----
data/processed/*.parquet
data/processed/xgb_model.json

# ---- Environment ----
venv/
.venv/
tmp/
__pycache__/
*.pyc

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Notebook backups written by patch_notebooks.py ----
*.bak
